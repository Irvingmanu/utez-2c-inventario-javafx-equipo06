<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="260" prefHeight="280" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.integradora.controllers.FormController">
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Agregar un producto" />
    <GridPane hgap="10" vgap="10">
        <Label text="Código:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Precio:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrecio" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Stock:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtStock" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Categoría:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCategoria" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <children>
        <HBox spacing="93">
            <Button mnemonicParsing="false" onAction="#onGuardar" text="Guardar" />
            <Button mnemonicParsing="false" onAction="#onCancelar" text="Cancelar"/>
        </HBox>
    </children>
</VBox>